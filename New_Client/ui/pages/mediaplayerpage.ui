  <property name="styleSheet">
   <string notr="true">QDialog#mediaplayerpage {
  background: qlineargradient(x1:0, y1:0, x2:1, y2:1, stop:0 #eef2f8, stop:1 #e6edf7);
}
QFrame#frame_header,
QFrame#frame_controls,
QFrame#frame_status_bar {
  background: #ffffff;
  border: 1px solid #d8dde6;
  border-radius: 8px;
}
QFrame#frame_video_container {
  background: #151a22;
  border: 1px solid #2b3240;
  border-radius: 10px;
}
QWidget#video_render_host {
  background: #10151d;
}
QLabel#lb_video_placeholder {
  color: #90a0b8;
  font-size: 17px;
  letter-spacing: 1px;
}
QPushButton {
  background: #f6f8fb;
  border: 1px solid #cfd6e2;
  border-radius: 6px;
  padding: 4px 12px;
  color: #1f2937;
}
QPushButton:hover {
  background: #e3ebfa;
  border: 1px solid #9fb4d9;
}
QPushButton:pressed {
  background: #d2def5;
  border: 1px solid #6f8fc4;
  padding-top: 5px;
  padding-left: 13px;
}
QPushButton#btn_play {
  background: #1f9d55;
  border: 1px solid #178045;
  color: white;
}
QPushButton#btn_play:hover {
  background: #25b25f;
  border: 1px solid #1c9650;
}
QPushButton#btn_play:pressed {
  background: #178045;
  border: 1px solid #126c3c;
}
QPushButton#btn_pause {
  background: #f2b01e;
  border: 1px solid #d89a13;
  color: #1f1f1f;
}
QPushButton#btn_pause:hover {
  background: #ffc239;
  border: 1px solid #dea01a;
}
QPushButton#btn_pause:pressed {
  background: #d89a13;
  border: 1px solid #b68110;
}
QPushButton#btn_stop {
  background: #e25555;
  border: 1px solid #c74747;
  color: white;
}
QPushButton#btn_stop:hover {
  background: #f06a6a;
  border: 1px solid #d75858;
}
QPushButton#btn_stop:pressed {
  background: #c74747;
  border: 1px solid #a93a3a;
}
QSlider::groove:horizontal {
  border: 1px solid #c9d1de;
  height: 6px;
  border-radius: 3px;
  background: #e9edf4;
}
QSlider::handle:horizontal {
  background: #5b78b3;
  border: 1px solid #4b669a;
  width: 14px;
  margin: -5px 0;
  border-radius: 7px;
}
QLabel#lb_page_title {
  color: #243449;
  font-size: 15px;
  font-weight: 700;
}
QLabel#lb_status_text, QLabel#lb_session, QLabel#lb_stream_text {
  color: #2a3b52;
}</string>
