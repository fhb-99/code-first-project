}
QPushButton {
  background: #f6f8fb;
  border: 1px solid #cfd6e2;
  border-radius: 6px;
  padding: 4px 12px;
}
QPushButton:hover {
  background: #e9eef7;
}
QPushButton:pressed {
  background: #dde6f5;
}
QPushButton#btn_play {
  background: #1f9d55;
  border: 1px solid #178045;
  color: white;
}
QPushButton#btn_pause {
  background: #f2b01e;
  border: 1px solid #d89a13;
  color: #1f1f1f;
}
QPushButton#btn_stop {
  background: #e25555;
  border: 1px solid #c74747;
  color: white;
}
QSlider::groove:horizontal {
  border: 1px solid #c9d1de;
  height: 6px;
  border-radius: 3px;
  background: #e9edf4;
}
QSlider::handle:horizontal {
  background: #5b78b3;
  border: 1px solid #4b669a;
  width: 14px;
  margin: -5px 0;
  border-radius: 7px;
}</string>
